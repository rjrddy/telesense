# Backend URL. Default: http://localhost:8000 for local dev.
# For Vercel production, set this to your Fly.io app URL:
#   VITE_API_URL=https://telesense-api.fly.dev
VITE_API_URL=http://localhost:8000

# Optional: hardcode the demo key into the frontend build. Usually leave this
# UNSET and let the KeyGate UI prompt visitors instead (so you can rotate the
# key without redeploying the frontend).
# VITE_TELESENSE_DEMO_KEY=
